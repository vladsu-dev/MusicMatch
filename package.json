{
  "name": "music-match",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "MusicMatch — React, Express, PostgreSQL и JWT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "server": "node --env-file=.env server/index.js",
    "server:dev": "node --env-file=.env --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate": "node --env-file=.env server/migrate.js",
    "test": "node --test server/test/*.test.js",
    "start": "node --env-file=.env server/index.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "jsonwebtoken": "^9.0.2",
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.14",
    "@playwright/test": "^1.55.0"
  }
}
