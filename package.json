{
  "name": "music-match",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Сайт знакомств по музыкальным вкусам: React + Express + SQLite",
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm:server\" \"npm:client\"",
    "server": "node server/index.js",
    "client": "vite",
    "build": "vite build",
    "start": "npm run build && node server/index.js",
    "seed": "node server/seed.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^5.4.14"
  }
}
